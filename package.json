{
  "name": "auto-api-open-api",
  "version": "1.0.0",
  "description": "Chrome DevTools extension that generates an OpenAPI specification from recorded requests",
  "scripts": {
    "dev": "npm run copy-static-files && tsc -p tsconfig.build.json --watch",
    "build": "npm run clean && npm run compile && npm run copy-static-files",
    "copy-static-files": "mkdir -p dist && cp src/manifest.json src/*.html src/*.png dist",
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "author": "Leonardo Vogel Dalcin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardodalcin/auto-api-open-api.git"
  },
  "dependencies": {
    "generate-schema": "^2.6.0",
    "openapi-types": "^12.1.3"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/har-format": "^1.2.16",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
